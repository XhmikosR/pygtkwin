diff --git a/ports/openssl/portfile.cmake b/ports/openssl/portfile.cmake
--- a/ports/openssl/portfile.cmake
+++ b/ports/openssl/portfile.cmake
@@ -26,10 +26,58 @@ vcpkg_from_github(
 )
 
 vcpkg_list(SET CONFIGURE_OPTIONS
-    enable-static-engine
-    enable-capieng
+    no-engine
     no-tests
     no-docs
+    # BleachBit debloat: build a TLS 1.2/1.3 client only.
+    # Drop legacy protocols, the legacy provider, compression,
+    # niche/regional ciphers and features not used by BleachBit.
+    # See https://github.com/bleachbit/pygtkwin/issues/14
+    no-legacy
+    no-comp
+    no-ssl3
+    no-ssl3-method
+    no-tls1
+    no-tls1-method
+    no-tls1_1
+    no-tls1_1-method
+    no-idea
+    no-mdc2
+    no-md4
+    no-bf
+    no-cast
+    no-camellia
+    no-aria
+    no-seed
+    no-sm2
+    no-sm3
+    no-sm4
+    no-rmd160
+    no-whirlpool
+    # scrypt must stay: CPython's _hashopenssl.c unconditionally defines
+    # PY_OPENSSL_HAS_SCRYPT and references EVP_PBE_scrypt, so no-scrypt
+    # breaks the python3 _hashlib link.
+    no-rc2
+    no-rc4
+    no-ec2m
+    no-srp
+    no-ts
+    no-cms
+    no-ct
+    no-srtp
+    no-gost
+    no-cmp
+    no-nextprotoneg
+    # CPython's _ssl and _hashlib don't use these either
+    no-quic
+    no-ocsp
+    no-http
+    no-des
+    no-ocb
+    no-siv
+    no-argon2
+    no-rfc3779
+    no-filenames
 )
 
 # https://github.com/openssl/openssl/blob/master/INSTALL.md#enable-ec_nistp_64_gcc_128
